# API
NODE_ENV=development
PORT=3000

# Banco de dados (defaults apontam para o PostgreSQL gerenciado via npm run db:start)
DATABASE_URL=postgres://advogado:advogado@127.0.0.1:54329/advogado

# Sessão
SESSION_SECRET=troque-esta-chave-em-producao-pelo-menos-32-caracteres
COOKIE_NAME=advogado_session
SESSION_TTL_DAYS=30

# Armazenamento
STORAGE_DRIVER=local
STORAGE_DIR=./data/storage

# CORS (frontend)
CORS_ORIGIN=http://localhost:5173

SUPER_ADMIN_EMAIL=implantador@exemplo.com
SUPER_ADMIN_PASSWORD=senha-forte-min-8
SUPER_ADMIN_NAME=Implantador

# IA (deixe OPENAI_API_KEY vazio para exibir "Serviço de IA não configurado")
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DataJud — API Pública do CNJ (consulta por número de processo)
# A chave também pode ser configurada tecnicamente em "integration.capture.datajud" (campo password).
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_MS=35000

# PJe (PDPJ-Br) — API oficial do PJe (docs.pje.jus.br / docs.pdpj.jus.br)
# Autenticação OAuth2 via Keycloak. Exige cliente registrado junto ao CNJ
# (integracaopdpj@cnj.jus.br) + credenciais de usuário do PJe.
# A configuração também pode ser feita por instalação em "integration.capture.pje".
PJE_CLIENT_ID=
PJE_CLIENT_SECRET=
PJE_USERNAME=
PJE_PASSWORD=
PJE_SSO_URL=https://sso.cloud.pje.jus.br/auth/realms/pje/protocol/openid-connect/token
PJE_GATEWAY_URL=https://gateway.cloud.pje.jus.br
PJE_TIMEOUT_MS=30000

# Monitoramento automático de processos (scheduler dentro da API)
# ======================================================================
# PRODUÇÃO: habilite e defina o intervalo conforme o administrador/implantação.
# DESENVOLVIMENTO/TESTE: para validar o fluxo automático rapidamente, use
#   PROCESS_MONITOR_ENABLED=true
#   PROCESS_MONITOR_INTERVAL_MINUTES=1
# e restaure o valor de produção antes do deploy.
PROCESS_MONITOR_ENABLED=false
PROCESS_MONITOR_INTERVAL_MINUTES=60
PROCESS_MONITOR_CONCURRENCY=2
# Um Case ACTIVE é considerado "atrasado" quando last_synced_at é mais antigo que
# INTERVALO x MULTIPLICADOR (padrão: 60 min x 2 = 120 min). Apenas visual/diagnóstico.
PROCESS_MONITOR_STALE_MULTIPLIER=2
